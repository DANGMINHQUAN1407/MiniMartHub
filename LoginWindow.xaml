    <Grid>

        <Label Content="MINI MART HUB" HorizontalAlignment="Left" Margin="102,27,0,0" VerticalAlignment="Top" Height="40" Width="245" FontFamily="Arial" FontSize="30" FontWeight="Bold"/>
        <Image HorizontalAlignment="Left" Height="72" Margin="10,11,0,0" VerticalAlignment="Top" Width="73" Source="/imgs/pngtree-mini-mart-shop-building-vector-png-png-image_7667348.png"/>
        <Label Content="EMAIL: " FontWeight="Bold" HorizontalAlignment="Left" Margin="224,148,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="400,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Height="33"/>
        <Label Content="PASSWORD: " FontWeight="Bold" HorizontalAlignment="Left" Margin="224,217,0,0" VerticalAlignment="Top"/>

        <TextBox HorizontalAlignment="Left" Margin="400,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Height="33"/>
        <Button Content="LOGIN" FontWeight="Bold" HorizontalAlignment="Left" Margin="490,292,0,0" VerticalAlignment="Top" Height="39" Width="90"/>


    </Grid>
</Window>
