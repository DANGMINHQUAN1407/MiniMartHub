        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniMartHub"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800"
        Background="Aqua"
        FontFamily="Arial"
        FontSize="20"
