<Window x:Class="MiniMartHub.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product" Height="400" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Label Content="Product Name"/>
            <TextBox x:Name="txtName"/>

            <Label Content="Price"/>
            <TextBox x:Name="txtPrice"/>

            <Label Content="Quantity"/>
            <TextBox x:Name="txtQuantity"/>

            <Label Content="Status"/>
            <ComboBox x:Name="cbStatus">
                <ComboBoxItem Content="ACTIVE"/>
                <ComboBoxItem Content="INACTIVE"/>
            </ComboBox>

            <Label Content="QR Image URL"/>
            <TextBox x:Name="txtQR"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Margin="5" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
