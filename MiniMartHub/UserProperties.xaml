<UserControl x:Class="MiniMartHub.UserProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MiniMartHub"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20" Margin="0,0,0,30">
            <StackPanel>
                <TextBlock Text="➕ Create New User" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           Margin="0,0,0,5"/>
                <TextBlock Text="Fill in the user details below" 
                           FontSize="14" 
                           Foreground="#BDC3C7"/>
            </StackPanel>
        </Border>
        
        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,0">
            <StackPanel MaxWidth="600">
                
                <!-- Personal Information Section -->
                <Border Background="#F8F9FA" 
                        CornerRadius="10" 
                        Padding="25" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📋 Personal Information" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50" 
                                   Margin="0,0,0,20"/>
                        
                        <!-- Name and Email Row -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Full Name -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Full Name *" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#555" 
                                           Margin="0,0,0,8"/>
                                <Border BorderBrush="#BDC3C7" 
                                        BorderThickness="2" 
                                        CornerRadius="8">
                                    <TextBox x:Name="txtName" 
                                             Height="40" 
                                             Padding="12,0" 
                                             FontSize="14"
                                             BorderThickness="0"
                                             Background="White"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Email -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email Address *" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#555" 
                                           Margin="0,0,0,8"/>
                                <Border BorderBrush="#BDC3C7" 
                                        BorderThickness="2" 
                                        CornerRadius="8">
                                    <TextBox x:Name="txtEmail" 
                                             Height="40" 
                                             Padding="12,0" 
                                             FontSize="14"
                                             BorderThickness="0"
                                             Background="White"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Phone and Date of Birth Row -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Phone Number -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Phone Number" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#555" 
                                           Margin="0,0,0,8"/>
                                <Border BorderBrush="#BDC3C7" 
                                        BorderThickness="2" 
                                        CornerRadius="8">
                                    <TextBox x:Name="txtPhone" 
                                             Height="40" 
                                             Padding="12,0" 
                                             FontSize="14"
                                             BorderThickness="0"
                                             Background="White"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Date of Birth -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date of Birth" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#555" 
                                           Margin="0,0,0,8"/>
                                <Border BorderBrush="#BDC3C7" 
                                        BorderThickness="2" 
                                        CornerRadius="8">
                                    <DatePicker x:Name="dpDateOfBirth" 
                                                Height="40" 
                                                Padding="12,0" 
                                                FontSize="14"
                                                BorderThickness="0"
                                                Background="White"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Address -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Address" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#555" 
                                       Margin="0,0,0,8"/>
                            <Border BorderBrush="#BDC3C7" 
                                    BorderThickness="2" 
                                    CornerRadius="8">
                                <TextBox x:Name="txtAddress" 
                                         Height="40" 
                                         Padding="12,0" 
                                         FontSize="14"
                                         BorderThickness="0"
                                         Background="White"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Account Information Section -->
                <Border Background="#F8F9FA" 
                        CornerRadius="10" 
                        Padding="25" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🔐 Account Information" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50" 
                                   Margin="0,0,0,20"/>
                        
                        <!-- Username and Password Row -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Username -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username *" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#555" 
                                           Margin="0,0,0,8"/>
                                <Border BorderBrush="#BDC3C7" 
                                        BorderThickness="2" 
                                        CornerRadius="8">
                                    <TextBox x:Name="txtUsername" 
                                             Height="40" 
                                             Padding="12,0" 
                                             FontSize="14"
                                             BorderThickness="0"
                                             Background="White"
                                             VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Password -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password *" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#555" 
                                           Margin="0,0,0,8"/>
                                <Border BorderBrush="#BDC3C7" 
                                        BorderThickness="2" 
                                        CornerRadius="8">
                                    <PasswordBox x:Name="txtPassword" 
                                                 Height="40" 
                                                 Padding="12,0" 
                                                 FontSize="14"
                                                 BorderThickness="0"
                                                 Background="White"
                                                 VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Role Selection -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Role *" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#555" 
                                       Margin="0,0,0,8"/>
                            <Border BorderBrush="#BDC3C7" 
                                    BorderThickness="2" 
                                    CornerRadius="8">
                                <ComboBox x:Name="cmbRole" 
                                          Height="40" 
                                          Padding="12,0" 
                                          FontSize="14"
                                          BorderThickness="0"
                                          Background="White">
                                    <ComboBoxItem Content="Admin"/>
                                    <ComboBoxItem Content="Manager"/>
                                    <ComboBoxItem Content="Cashier"/>
                                    <ComboBoxItem Content="Customer"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                        
                        <!-- Status -->
                        <StackPanel>
                            <TextBlock Text="Status" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#555" 
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbActive" 
                                             Content="Active" 
                                             IsChecked="True" 
                                             FontSize="14" 
                                             Foreground="#27AE60" 
                                             FontWeight="SemiBold" 
                                             Margin="0,0,20,0"/>
                                <RadioButton x:Name="rbInactive" 
                                             Content="Inactive" 
                                             FontSize="14" 
                                             Foreground="#E74C3C" 
                                             FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="20" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnSave" 
                        Content="💾 Save User" 
                        Width="150" 
                        Height="45" 
                        Margin="10,0"
                        Background="#27AE60"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#229954"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button x:Name="btnCancel" 
                        Content="❌ Cancel" 
                        Width="150" 
                        Height="45" 
                        Margin="10,0"
                        Background="#95A5A6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#7F8C8D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
