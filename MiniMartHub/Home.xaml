<Window x:Class="MiniMartHub.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniMartHub"
        mc:Ignorable="d"
        Title="MiniMart Hub - Dashboard" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"    
        FontFamily="Segoe UI">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel>
                <!-- Logo and Brand -->
                <StackPanel Orientation="Horizontal" Margin="20" VerticalAlignment="Center">
                    <Image Height="50" Width="50" Margin="0,0,10,0"
                           Source="pack://application:,,,/MiniMartHub;component/imgs/pngtree-mini-mart-shop-building-vector-png-png-image_7667348.png"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mini Mart Hub" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="Management System" 
                                   FontSize="10" 
                                   Foreground="#BDC3C7"/>
                    </StackPanel>
                </StackPanel>
                
                <Separator Background="#34495E" Margin="10,0"/>
                
                <!-- Navigation Menu -->
                <StackPanel Margin="0,20,0,0">
                    <Border x:Name="menuUserManagement" 
                            Background="Transparent" 
                            CornerRadius="5" 
                            Margin="10,5"
                            Cursor="Hand"
                            MouseLeftButtonDown="dgUserManagement_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" Margin="15,12">
                            <TextBlock Text="👥" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="User Management" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="White" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Border x:Name="menuProductManagement"
        Background="Transparent" 
        CornerRadius="5" 
        Margin="10,5"
        Cursor="Hand"
        MouseLeftButtonDown="dgProductManagement_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" Margin="15,12">
                            <TextBlock Text="📦" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Product Management" 
                   FontSize="14" 
                   FontWeight="Medium" 
                   Foreground="White" 
                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>


                    <Border Background="Transparent" 
                            CornerRadius="5" 
                            Margin="10,5"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Margin="15,12">
                            <TextBlock Text="🛒" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Order Management" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="White" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    
                    <Border Background="Transparent" 
                            CornerRadius="5" 
                            Margin="10,5"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Margin="15,12">
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="White" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3498DB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                
                <!-- Logout Button -->
                <Border Background="#E74C3C" 
                        CornerRadius="5" 
                        Margin="10"
                        VerticalAlignment="Bottom"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Margin="15,12" HorizontalAlignment="Center">
                        <TextBlock Text="🚪" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Logout" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#ECF0F1" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center">
                        <Border Background="#3498DB" 
                                CornerRadius="20" 
                                Padding="15,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👋" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Welcome, Admin" 
                                           FontSize="14" 
                                           FontWeight="Medium" 
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content Area -->
            <Border Grid.Row="1" Background="#F8F9FA" Padding="20">
                <ContentControl x:Name="MainContentControl">
                    <!-- Default Dashboard Content -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Welcome Message -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <TextBlock Text="Chào mừng đến với Mini Mart Hub!" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50" 
                                       TextAlignment="Center" 
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Hệ thống quản lý cửa hàng thông minh và hiệu quả" 
                                       FontSize="16" 
                                       Foreground="#7F8C8D" 
                                       TextAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Quick Stats Cards -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Users Card -->
                            <Border Grid.Column="0" 
                                    Background="White" 
                                    CornerRadius="10" 
                                    Margin="10"
                                    Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect Color="LightGray" BlurRadius="10" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="👥" FontSize="32" TextAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Users" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="125" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#3498DB" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Products Card -->
                            <Border Grid.Column="1" 
                                    Background="White" 
                                    CornerRadius="10" 
                                    Margin="10"
                                    Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect Color="LightGray" BlurRadius="10" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📦" FontSize="32" TextAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Products" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="1,234" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#27AE60" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Orders Card -->
                            <Border Grid.Column="2" 
                                    Background="White" 
                                    CornerRadius="10" 
                                    Margin="10"
                                    Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect Color="LightGray" BlurRadius="10" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🛒" FontSize="32" TextAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Orders" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="567" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#F39C12" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Revenue Card -->
                            <Border Grid.Column="3" 
                                    Background="White" 
                                    CornerRadius="10" 
                                    Margin="10"
                                    Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect Color="LightGray" BlurRadius="10" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="💰" FontSize="32" TextAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Revenue" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="$45,678" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               TextAlignment="Center" 
                                               Foreground="#E74C3C" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
