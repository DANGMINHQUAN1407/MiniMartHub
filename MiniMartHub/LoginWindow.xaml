<Window x:Class="MiniMartHub.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniMartHub"
        mc:Ignorable="d"
        Title="MiniMart Hub - Login" Height="600" Width="900"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        >
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Side - Branding -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Height="120" Width="120" Margin="0,0,0,20"
                   Source="pack://application:,,,/MiniMartHub;component/imgs/pngtree-mini-mart-shop-building-vector-png-png-image_7667348.png"/>
            <TextBlock Text="MINI MART HUB" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Quản lý cửa hàng thông minh" 
                       FontSize="16" 
                       Foreground="#E0E0E0" 
                       TextAlignment="Center"/>
        </StackPanel>
        
        <!-- Right Side - Login Form -->
        <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="15" 
                Margin="20"
                Padding="40">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng nhập" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#333" 
                           TextAlignment="Center" 
                           Margin="0,0,0,30"/>
                
                <!-- Email Field -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Email" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#555" 
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD" 
                            BorderThickness="2" 
                            CornerRadius="8">
                        <TextBox x:Name="txtEmail" 
                                 Height="45" 
                                 Padding="15,0" 
                                 FontSize="14"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>
                
                <!-- Password Field -->
                <StackPanel Margin="0,0,0,30">
                    <TextBlock Text="Password" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#555" 
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD" 
                            BorderThickness="2" 
                            CornerRadius="8">
                        <PasswordBox x:Name="txtPassword" 
                                     Height="45" 
                                     Padding="15,0" 
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>
                
                <!-- Login Button -->
                <Button x:Name="btnLogin" 
                        Content="ĐĂNG NHẬP" 
                        Height="50" 
                        FontSize="16" 
                        FontWeight="Bold" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnLogin_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
