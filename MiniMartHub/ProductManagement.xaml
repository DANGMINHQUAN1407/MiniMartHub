<UserControl x:Class="MiniMartHub.ProductManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add" Width="80" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Edit" Width="80" Margin="5" Click="BtnEdit_Click"/>
            <Button Content="Delete" Width="80" Margin="5" Click="BtnDelete_Click"/>
            <Button Content="Refresh" Width="80" Margin="5" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- DataGrid for products -->
        <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" 
                  AlternatingRowBackground="LightGray" RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:N0} đ}" Width="120"/>
                <DataGridTextColumn Header="In Stock" Binding="{Binding QuantityInStorage}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="QR URL" Binding="{Binding QrimageUrl}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
